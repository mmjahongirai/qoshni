# Safe local-development defaults. Do not put secrets in this file.
QOSHNI_ENVIRONMENT=development
QOSHNI_APP_NAME=QO'SHNI Backend
QOSHNI_SERVICE_NAME=qoshni-backend
QOSHNI_APP_VERSION=0.1.0
QOSHNI_API_V1_PREFIX=/api/v1

# Optional. Leave unset to run the API without a database connection.
# Supabase example (replace placeholders; never commit real passwords):
# QOSHNI_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DATABASE_URL is also accepted as an alias for the same setting.

# Optional SQLAlchemy pool settings (defaults shown):
# QOSHNI_DATABASE_POOL_SIZE=5
# QOSHNI_DATABASE_MAX_OVERFLOW=10
# QOSHNI_DATABASE_POOL_TIMEOUT=30
# QOSHNI_DATABASE_POOL_RECYCLE=1800
# QOSHNI_DATABASE_ECHO=false

# Alembic uses the same QOSHNI_DATABASE_URL when you run migration commands manually.
# Use a direct Supabase session connection for migrations, not the transaction pooler.
